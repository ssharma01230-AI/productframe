DATABASE_URL=postgresql+psycopg://productframe:productframe@localhost:5432/productframe
REDIS_URL=redis://localhost:6379/0
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=productframe
MINIO_SECRET_KEY=productframe-local-password
MINIO_BUCKET=productframe-local
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Select the image provider for the user-facing generation test.
# Keep this as openai to roll back.
IMAGE_GENERATION_PROVIDER=openai
OPENAI_IMAGE_MODEL=gpt-image-2.5-flare
OPENAI_IMAGE_TIMEOUT_SECONDS=300
OPENAI_IMAGE_FIDELITY_VALIDATION=false
# Optional: adding a Gemini key enables the hybrid route.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# Separate model for image generation; must be enabled for the Gemini project.
GEMINI_IMAGE_MODEL=gemini-3.1-flash-lite-image
GEMINI_IMAGE_TIMEOUT_SECONDS=300
ANALYSIS_PROVIDER_MODE=hybrid
# Total concurrency across providers. Use one worker process.
ANALYSIS_CONCURRENCY=3
GENERATION_RECOVERY_LEASE_SECONDS=600
# Number of isolated Redis consumers started by `productframe-worker run`.
GENERATION_WORKERS=1
ANALYSIS_MAX_INPUT_TOKENS=110000
ANALYSIS_MAX_OUTPUT_TOKENS=4096
ANALYSIS_TOKENS_PER_MINUTE=180000
ANALYSIS_REQUESTS_PER_MINUTE=60
# Application budgets: check the actual limits for your Gemini project/model.
GEMINI_MAX_INPUT_TOKENS=32000
GEMINI_TOKENS_PER_MINUTE=225000
GEMINI_REQUESTS_PER_MINUTE=4
GEMINI_REQUESTS_PER_DAY=18
# Optional absolute path; defaults to <repository>/.cache/analysis-quotas.sqlite3.
# ANALYSIS_QUOTA_DB=/absolute/path/to/analysis-quotas.sqlite3
