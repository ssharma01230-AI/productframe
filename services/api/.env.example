DATABASE_URL=postgresql+psycopg://productframe:productframe@localhost:5432/productframe
REDIS_URL=redis://localhost:6379/0
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=productframe
MINIO_SECRET_KEY=productframe-local-password
MINIO_BUCKET=productframe-local
CLERK_JWKS_URL=
CLERK_ISSUER=
CLERK_AUDIENCE=
CORS_ORIGINS=http://localhost:3000
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Optional: adding a Gemini key enables the hybrid route.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
ANALYSIS_PROVIDER_MODE=hybrid
# Total concurrency across providers. Use one worker process.
ANALYSIS_CONCURRENCY=3
ANALYSIS_MAX_INPUT_TOKENS=110000
ANALYSIS_MAX_OUTPUT_TOKENS=4096
ANALYSIS_TOKENS_PER_MINUTE=180000
ANALYSIS_REQUESTS_PER_MINUTE=60
# Application budgets: check the actual limits for your Gemini project/model.
GEMINI_MAX_INPUT_TOKENS=32000
GEMINI_TOKENS_PER_MINUTE=225000
GEMINI_REQUESTS_PER_MINUTE=4
GEMINI_REQUESTS_PER_DAY=18
